# Local Supabase (npm run db:start). These demo keys are identical on every
# machine and grant nothing beyond localhost.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54821
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local anon key from `npm run db:status`>

# Shows the email+password panel on /login. Gated on this flag AND a localhost
# Supabase URL, so it cannot appear against the cloud project.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true

# Cloud project — fill in and swap when you are ready.
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
